---
/**
 * La banda de novedades de la portada: las NOVETATS_PORTADA siguientes a la que ya ensena la
 * cabecera (NOVETAT_ULTIMA), una por linea, entre las cifras y el indice, con el enlace a la
 * pagina completa. No hay nada que hacer a mano: sale de content/novetats.json.
 */
import { getCollection } from 'astro:content';
import Novetat from './Novetat.astro';
import { urlPagina, type Lang } from '../site/config';
import { NOVETATS, NOVETATS_PORTADA, NOVETAT_ULTIMA } from '../site/novetats';
import { ui } from '../site/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui(lang);
const projectes = new Map((await getCollection('projectes')).map((p) => [p.data.slug, p]));
const ultimes = NOVETATS.filter((n) => n !== NOVETAT_ULTIMA).slice(0, NOVETATS_PORTADA);
---

{ultimes.length > 0 && (
  <section class="novetats" aria-labelledby="novetats-titol">
    <div class="contenidor novetats-fila">
      <h2 id="novetats-titol">{NOVETAT_ULTIMA ? t.novetatsAnteriors : t.novetatsTitol}</h2>
      <ol class="novetats-llista">
        {ultimes.map((n) => <Novetat novetat={n} projectes={projectes} lang={lang} />)}
      </ol>
      <a class="novetats-totes" href={urlPagina(lang, 'novetats')}>{t.novetatsTotes} →</a>
    </div>
  </section>
)}
