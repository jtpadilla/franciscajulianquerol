---
/**
 * Una novedad, en una linea: la fecha y que ha pasado, con el titulo del proyecto enlazado a su
 * sitio. La usan la cabecera de la portada y la pagina de novedades.
 */
import type { CollectionEntry } from 'astro:content';
import { METRIQUES, type Lang } from '../site/config';
import { dataLlarga, type Novetat } from '../site/novetats';
import { ui, textCanvis } from '../site/ui';

interface Props {
  novetat: Novetat;
  projectes: Map<string, CollectionEntry<'projectes'>>;
  lang: Lang;
  /** «li» en las listas (por defecto); la cabecera de la portada pide un «p». */
  element?: 'li' | 'p';
}
const { novetat: n, projectes, lang, element = 'li' } = Astro.props;
const Element = element;
const t = ui(lang);
const p = n.projecte ? projectes.get(n.projecte)?.data : undefined;
---

{/* Una novedad de un proyecto que ya no esta en el indice no se ensena. */}
{(n.tipus === 'nota' || p) && (
  <Element class="novetat">
    <time datetime={n.data}>{dataLlarga(n.data, lang)}</time>
    <span>
      {n.tipus === 'nota' && (n.url ? <a href={n.url}>{n.nota![lang]}</a> : n.nota![lang])}
      {n.tipus === 'nou' && p && (
        <Fragment set:html={t.novetatNou(`<a href="${p.url}" rel="noopener">${p.titol}</a>`)} />
      )}
      {n.tipus === 'creix' && p && (
        <Fragment
          set:html={t.novetatCreix(
            `<a href="${p.url}" rel="noopener">${p.titol}</a>`,
            textCanvis(n.canvis ?? {}, METRIQUES.projectes[n.projecte!]!, lang),
          )}
        />
      )}
    </span>
  </Element>
)}
