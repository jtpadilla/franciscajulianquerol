---
import { METRIQUES, LLOC, xifra, type Lang } from '../site/config';
import { ui } from '../site/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui(lang);
const total = METRIQUES.totals;

/**
 * El orden en que se leen; cada una con su plural. Solo obra de la autora: las traducciones de
 * ramblacelumbres (`totals.traduccions`) son trabajo de esta edicion y se quedan fuera; la ficha
 * de ese proyecto ya dice «4 idiomas».
 */
const CAMPS = ['projectes', 'textos', 'paraules', 'fotografies', 'peces'] as const;

const data = new Date(METRIQUES.generat).toLocaleDateString(LLOC.locale[lang], {
  day: 'numeric', month: 'long', year: 'numeric',
});
---

<section class="xifres" aria-labelledby="xifres-titol">
  <div class="contenidor">
    <h2 id="xifres-titol" class="ocult-visual">{t.xifresTitol}</h2>

    <dl class="xifres-graella">
      {CAMPS.map((camp) => {
        const n = total[camp];
        const [singular, plural] = t.metriques[camp]!;
        return (
          <div class="xifra">
            {/* dt antes que dd, como pide el HTML; el CSS invierte el orden visual. */}
            <dt>{n === 1 ? singular : plural}</dt>
            <dd>{xifra(n, lang)}</dd>
          </div>
        );
      })}
    </dl>

    <p class="xifres-peu">{t.xifresPeu(data)}</p>
  </div>
</section>
